{
  "name": "radar-cnpj-mcp",
  "version": "0.1.0",
  "description": "MCP server and CLI to find Brazilian companies by CNAE and region using the Receita Federal open CNPJ data",
  "keywords": [
    "mcp",
    "mcp-server",
    "cnpj",
    "cnae",
    "receita-federal",
    "leads",
    "prospeccao",
    "brasil"
  ],
  "license": "MIT",
  "author": "Wenderson Melo",
  "type": "module",
  "bin": {
    "radar-cnpj-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  }
}
